# Copy this file to .env and fill in real values.
# On Render, add each of these under Dashboard → Your Service → Environment instead.

# MongoDB Atlas connection string
MONGO_URI=

# Secret used to sign admin JWT tokens (use a long random string)
JWT_SECRET=

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=WorldMic2025!

# Groq API key — powers all AI features (post writing, comment replies, chat widget, etc.)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary — optional fallback for image hosting (featured images, ad banners, AI-generated images).
# You don't have to fill these in: the active image host provider (Cloudinary, ImageKit, Uploadcare,
# ImgBB, or a Custom API) and its credentials are chosen in Admin → Settings → Image Hosting instead,
# and stored in the database — no redeploy needed to add/change it. These env vars are only used as a
# fallback for Cloudinary specifically if you pick Cloudinary there but leave its fields blank here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server port (Render sets this automatically; only needed for local dev)
PORT=3000

# Note: the Stability AI key for AI image generation is NOT set here.
# It's entered by the admin directly in Admin → Settings → AI Image Generation,
# and stored in the database — no redeploy needed to add/change it.

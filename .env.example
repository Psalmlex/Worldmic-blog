# Copy this file to .env and fill in real values.
# On Render, add each of these under Dashboard → Your Service → Environment instead.

# MongoDB Atlas connection string
MONGO_URI=

# Secret used to sign admin JWT tokens (use a long random string)
JWT_SECRET=

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=WorldMic2025!

# Groq API key — powers all AI features (post writing, comment replies, chat widget, etc.)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary — used for image hosting (featured images, ad banners, AI-generated images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server port (Render sets this automatically; only needed for local dev)
PORT=3000

# Note: AI image generation API keys are NOT set here.
# They're entered by the admin directly in Admin → Settings → AI Image Generation
# (Stability AI, OpenAI, OpenRouter, Google Gemini, Replicate, Hugging Face, Pollinations.ai,
# or Web Image Search), and stored in the database — no redeploy needed to add/change it.
